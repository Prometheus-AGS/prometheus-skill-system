# Dependencies
node_modules/
!package-lock.json
!site/package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.log

# Generated Docusaurus cache (site/build and site/node_modules already covered
# above; the .docusaurus cache is regenerated on every build).
site/.docusaurus/

# surreal-memory / forge embedded RocksDB runtime database. The server's default
# SURREAL_PATH is ./data/memory.db, so it materializes here when run from the
# repo root. Runtime state — never committed.
/data/memory.db/
memory.db/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Test artifacts
coverage/
.nyc_output/

# Environment
.env
.env.local
.env.*.local
.claude/
tools/prometheus-cli/target/
tools/forge-rs/target/
tools/surreal-memory-server/target/
tools/liter-llm/target/
tools/prometheus-knowledge/target/
substrate/*/target/

# Build output — symlinks created by `npm run build`.
# NOTE: .claude-plugin/hooks is intentionally tracked (committed symlink) so the
# hooks-integrity CI check and plugin.json's "./hooks/hooks.json" resolve in a
# fresh checkout without running the build. See CLAUDE.md "Canonical hooks path".
.claude-plugin/agents
.claude-plugin/skills
SCRATCHPAD.md

# surreal-memory write outbox (runtime artifact, never committed)
.kbd-orchestrator/memory-outbox.jsonl

# Hook-log lock files (runtime; the .log itself is covered by *.log above, but
# the sidecar *.jsonl.lock / *.log.lock advisory locks are not).
*.log.lock
*.jsonl.lock

# Git worktrees
.worktrees/

# Machine-local runtime state
.prometheus/
!.prometheus/knowledge/wiki/
!.prometheus/knowledge/wiki/*.md
!.prometheus/knowledge/wiki/index.md
!.prometheus/knowledge/wiki/log.md
.kbd-orchestrator/**/project.json

# Local env overrides
.envrc
*.local.env
