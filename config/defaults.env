# Single source of truth for install-time identity and paths.
#
# Three scripts install or manage the same LaunchAgents:
#   scripts/install-mcp-services.sh          (11 services)
#   scripts/prometheus-services.sh           (start/stop/status/doctor)
#   scripts/install-prometheus-exec-service.sh (ai.prometheus.exec)
#
# They disagreed on who the services belong to. install-mcp-services.sh derived
# the account with `id -un`; prometheus-services.sh hard-coded a personal
# username as its default AND enforced the match, so the script simply refused
# to run for anybody else. That is not a preference, it is a portability defect:
# the repo is published, and a hard-coded operator name cannot be correct on
# another machine.
#
# Every one of those scripts now sources this file, so the default is derived
# once, here.
#
# Override precedence (highest wins):
#   1. an explicit --user flag
#   2. PROMETHEUS_USER already exported in the environment
#   3. this file
#
# Sourcing contract: this file must stay pure assignments — no side effects, no
# output. It is sourced under `set -euo pipefail`, and it must not clobber a
# value the caller already set.

# The account that owns the LaunchAgents / systemd user units. Must be the user
# whose GUI session the agents attach to.
: "${PROMETHEUS_USER:=$(id -un)}"

# Root of the per-user Prometheus state directory.
: "${PROMETHEUS_HOME_DIR:=${HOME}/.prometheus}"

# Where services write stdout/stderr. Referenced by the plists as
# __PROMETHEUS_LOG_DIR__.
: "${PROMETHEUS_LOG_DIR:=${PROMETHEUS_HOME_DIR}/logs}"

# Where installed binaries land.
: "${PROMETHEUS_BIN_DIR:=${HOME}/.local/bin}"

# The immutable plugin generation root.
: "${PROMETHEUS_PLUGIN_ROOT:=${PROMETHEUS_HOME_DIR}/plugins/prometheus-skill-pack}"

export PROMETHEUS_USER PROMETHEUS_HOME_DIR PROMETHEUS_LOG_DIR \
       PROMETHEUS_BIN_DIR PROMETHEUS_PLUGIN_ROOT
