<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/render-supervisor-plist.mjs. Do not edit in place;
     edit this template and re-render so every service stays consistent. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@LABEL@@</string>

  <!-- R1.2: the dictionary form restarts crashes without fighting a planned
       stop. Bare <true/> also restarts a deliberate `launchctl bootout`. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <!-- R1.1: restarting faster than launchd's threshold gets the job removed
       rather than throttled, and the removal is silent. -->
  <key>ThrottleInterval</key>
  <integer>@@THROTTLE@@</integer>

  <!-- R1.3: a background-classified job is terminated first under pressure. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- R1.5: without this the service is down after every reboot. -->
  <key>RunAtLoad</key>
  <true/>

  <key>ProgramArguments</key>
  <array>
@@PROGRAM_ARGUMENTS@@
  </array>

  <!-- R1.4: without explicit paths the output is unreachable and a failure
       leaves no evidence. -->
  <key>StandardOutPath</key>
  <string>@@STDOUT_PATH@@</string>
  <key>StandardErrorPath</key>
  <string>@@STDERR_PATH@@</string>

  <key>WorkingDirectory</key>
  <string>@@WORKING_DIRECTORY@@</string>

  <key>EnvironmentVariables</key>
  <dict>
@@ENVIRONMENT@@
  </dict>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
</dict>
</plist>
