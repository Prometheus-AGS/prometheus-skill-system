    "peer-profile-sync",
    "pem-local-first",
    "reference-ui-fidelity",
    "sync-doctrine",
    "tauri-custom-titlebar",
    "tauri-ui-review",
    "entity-graph-web-shell",
    "mini-app-module",
    "axum-agent-gateway",
    "legacy-app-embed",
    "a2ui-surface-contract",
    "agui-event-contract",
    "agent-runtime-security",
    "anonymized-replica",
    "persona-scoped-agent",
