{
  "$schema": "./schemas/builder-manifest.schema.json",
  "schemaVersion": 1,
  "package": {
    "id": "hybrid-mobile-architecture",
    "displayName": "KnowMe Builder",
    "version": "2.0.0-alpha.4",
    "description": "Versioned, non-destructive application generator and instruction pack for governed agentic applications.",
    "license": "MIT",
    "homepage": "https://github.com/Know-Me-Tools/hybrid-mobile-architecture-skill",
    "repository": "https://github.com/Know-Me-Tools/hybrid-mobile-architecture-skill",
    "author": {
      "name": "Travis James",
      "email": "travis@prometheusags.ai",
      "url": "https://travisjames.ai"
    },
    "organization": "Prometheus Agentic Growth Solutions"
  },
  "contracts": {
    "prometheus": "./compatibility/prometheus-control-plane.json",
    "uar": "./compatibility/uar-runtime.json",
    "agentSkills": "1.0"
  },
  "distribution": {
    "skillSourceRoot": "skills",
    "packageSkill": "hybrid-mobile-architecture"
  },
  "profiles": {
    "sovereign-hybrid": {
      "description": "Flutter mobile, Tauri desktop, Rust adapters, embedded UAR on mobile, and service UAR on desktop/web.",
      "surfaces": [
        "flutter-mobile",
        "tauri-desktop",
        "rust-core"
      ],
      "uarMode": "hybrid",
      "runnableVerticalSlice": true
    },
    "governed-web-shell": {
      "description": "React web shell and Axum BFF with service UAR, AG-UI/A2UI, PEM/PGlite, governed identity, and optional legacy embedding.",
      "surfaces": [
        "react-web",
        "axum-bff"
      ],
      "uarMode": "service",
      "runnableVerticalSlice": true
    },
    "flutter-mobile": {
      "description": "Flutter mobile surface with Rust/FRB bindings and embedded UAR.",
      "surfaces": [
        "flutter-mobile",
        "rust-core"
      ],
      "uarMode": "embedded",
      "runnableVerticalSlice": true
    },
    "tauri-desktop": {
      "description": "Tauri desktop surface with React and service or in-process UAR facade.",
      "surfaces": [
        "tauri-desktop",
        "rust-core"
      ],
      "uarMode": "service",
      "runnableVerticalSlice": true
    },
    "axum-web": {
      "description": "Axum BFF and React web surface with service UAR.",
      "surfaces": [
        "react-web",
        "axum-bff"
      ],
      "uarMode": "service",
      "runnableVerticalSlice": true
    }
  },
