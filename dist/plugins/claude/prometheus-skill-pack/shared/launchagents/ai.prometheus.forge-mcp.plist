<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.prometheus.forge-mcp</string>

  <key>ProgramArguments</key>
  <array>
    <string>__FORGE_BIN__</string>
    <string>mcp</string>
    <string>--port</string>
    <string>8943</string>
    <string>--project-root</string>
    <string>__PROMETHEUS_ROOT__</string>
    <string>--skills-root</string>
    <string>__PROMETHEUS_ROOT__</string>
    <string>--pk-mcp-url</string>
    <string>http://localhost:8942/mcp</string>
    <!-- No bearer auth. The default bind is 127.0.0.1, and forge REFUSES to
         start if --no-auth is combined with a non-loopback --bind, so this
         cannot silently publish an unauthenticated API to the network.

         Replaces a committed dev token that every client had to copy. The
         token bought nothing here: it was a fixed string in this file, in
         .mcp.json, and in each harness config, so any local process that could
         reach :8943 could also read it. Removing it deletes a credential that
         had to be threaded into every new client -- MCP clients that support no
         header at all (Kimi Desktop's url form was the case that surfaced this)
         simply work now. -->
    <string>--no-auth</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROMETHEUS_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__PROMETHEUS_HOME__</string>
    <key>USER</key>
    <string>__PROMETHEUS_USER__</string>
    <key>PATH</key>
    <string>__PROMETHEUS_PATH__</string>
    <key>PK_MCP_URL</key>
    <string>http://localhost:8942/mcp</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Do not hot-loop on a failure that will not clear on its own.

       KeepAlive=true with no throttle restarts the daemon IMMEDIATELY. When the
       failure is persistent — an unwritable path, a port already bound, a
       missing binary — that is a tight loop: observed 2026-07-28 on
       sovereign-sync writing thousands of identical lock-failure lines, which
       buries any other diagnostic and burns CPU without ever recovering.

       Worse, launchd treats a job that respawns more than 5 times in 10s as
       misbehaving and may stop respawning it, at which point KeepAlive is
       silently meaningless.

       10s is launchd's own default for a reason. A transient crash still
       restarts promptly; a persistent one leaves a readable log and a machine
       that is not spinning. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__PROMETHEUS_LOG_DIR__/forge-mcp.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROMETHEUS_LOG_DIR__/forge-mcp.stderr.log</string>
</dict>
</plist>
