<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.prometheus.pk-cherry</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PK_CHERRY_BIN__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROMETHEUS_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__PROMETHEUS_HOME__</string>
    <key>USER</key>
    <string>__PROMETHEUS_USER__</string>
    <key>PATH</key>
    <string>__PROMETHEUS_PATH__</string>
    <key>PK_BIND</key>
    <string>127.0.0.1:8942</string>
    <key>PK_KB_DIR</key>
    <!-- Serve the PROJECT KB (repo-scoped), matching WorkingDirectory above, so the
         HTTP/MCP daemon reflects the same KB the pk CLI hooks (pk-ingest-on-reflect,
         bounded context dispatcher and supervised learning worker) read and write. -->
    <string>__PROMETHEUS_ROOT__/.prometheus/knowledge</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Do not hot-loop on a failure that will not clear on its own.

       KeepAlive=true with no throttle restarts the daemon IMMEDIATELY. When the
       failure is persistent — an unwritable path, a port already bound, a
       missing binary — that is a tight loop: observed 2026-07-28 on
       sovereign-sync writing thousands of identical lock-failure lines, which
       buries any other diagnostic and burns CPU without ever recovering.

       Worse, launchd treats a job that respawns more than 5 times in 10s as
       misbehaving and may stop respawning it, at which point KeepAlive is
       silently meaningless.

       10s is launchd's own default for a reason. A transient crash still
       restarts promptly; a persistent one leaves a readable log and a machine
       that is not spinning. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__PROMETHEUS_LOG_DIR__/pk-cherry.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROMETHEUS_LOG_DIR__/pk-cherry.stderr.log</string>
</dict>
</plist>
