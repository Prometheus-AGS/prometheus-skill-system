{
  "$schema": "./schemas/skill-system.schema.json",
  "imports": [],
  "inventory": {
    "excludedImports": [],
    "roots": [
      {
        "id": "packaged",
        "path": "skills",
        "scan": "children"
      }
    ]
  },
  "marketplace": {
    "plugins": [
      {
        "category": "frontend",
        "name": "prometheus-ui-ux-skills",
        "path": "skills/ui-ux",
        "version": "1.0.2"
      },
      {
        "category": "frontend",
        "name": "prometheus-react-skills",
        "path": "skills/react/prometheus-entity-skills",
        "version": "1.6.0"
      },
      {
        "category": "productivity",
        "name": "prometheus-process-skills",
        "path": "skills/process",
        "version": "1.9.0"
      },
      {
        "category": "devops",
        "name": "prometheus-devops-skills",
        "path": "skills/devops",
        "version": "1.6.0"
      },
      {
        "category": "testing",
        "name": "prometheus-testing-skills",
        "path": "skills/testing",
        "version": "1.7.0"
      },
      {
        "category": "productivity",
        "name": "learn",
        "path": "skills/learn",
        "version": "1.6.2"
      },
      {
        "category": "productivity",
        "name": "prometheus-librefang-skills",
        "path": "skills/rust/librefang-wasm-skill",
        "version": "1.5.2"
      },
      {
        "category": "productivity",
        "name": "cowork-management",
        "path": "skills/process/cowork-management",
        "version": "1.0.2"
      },
      {
        "category": "devops",
        "name": "disk-space-guardian",
        "path": "skills/devops/disk-space-guardian",
        "version": "1.0.2"
      },
      {
        "category": "productivity",
        "name": "prometheus-research-skills",
        "path": "skills/research",
        "version": "1.2.0"
      },
      {
        "category": "productivity",
        "name": "prometheus-research-server",
        "path": "substrate/prometheus-research",
        "version": "1.7.2"
      },
      {
        "category": "development",
        "name": "prometheus-rust-skills",
        "path": "skills/rust",
        "version": "1.0.0"
      },
      {
        "category": "development",
        "name": "prometheus-flint-skills",
        "path": "skills/flint",
        "version": "1.0.0"
      },
      {
        "category": "development",
        "name": "prometheus-architecture-skills",
        "path": "skills/architecture",
        "version": "1.0.0"
      },
      {
        "category": "productivity",
        "name": "prometheus-document-extraction-skills",
        "path": "skills/document-extraction",
        "version": "1.0.0"
      },
      {
        "category": "productivity",
        "name": "prometheus-documentation-skills",
        "path": "skills/documentation",
        "version": "1.0.0"
      },
      {
        "category": "frontend",
        "name": "prometheus-flutter-skills",
        "path": "skills/flutter",
        "version": "1.0.0"
      },
      {
        "category": "development",
        "name": "prometheus-go-skills",
        "path": "skills/go",
        "version": "1.0.0"
      },
      {
        "category": "frontend",
        "name": "prometheus-htmx-skills",
        "path": "skills/htmx",
        "version": "1.0.0"
      },
      {
        "category": "development",
        "name": "prometheus-python-skills",
        "path": "skills/python",
        "version": "1.0.0"
      },
      {
        "category": "frontend",
        "name": "prometheus-tauri-skills",
        "path": "skills/tauri",
        "version": "1.0.0"
      },
      {
        "category": "development",
        "name": "prometheus-typescript-skills",
        "path": "skills/typescript",
        "version": "1.0.0"
      },
      {
        "category": "frontend",
        "name": "prometheus-react-vite-stack",
        "path": "skills/react/react-vite-stack",
        "version": "1.0.0"
      },
      {
        "category": "productivity",
        "name": "iterative-evolver",
        "path": "skills/process/iterative-evolver",
        "version": "1.1.0"
      }
    ]
  },
  "minimumActiveVersion": "1.11.0",
  "name": "prometheus-skill-pack",
  "outputs": {
    "claudeMarketplace": ".claude-plugin/marketplace.json",
    "claudePackage": "dist/plugins/claude/prometheus-skill-pack",
    "codexMarketplace": ".agents/plugins/marketplace.json",
    "codexPackage": "dist/plugins/codex/prometheus-skill-pack",
    "skillCatalog": "SKILLS.md"
  },
  "platforms": {
    "full": [
      "darwin",
      "linux"
    ],
    "skills": [
      "darwin",
      "linux",
      "windows-git-bash",
      "windows-wsl"
    ]
  },
  "profiles": {
    "full": {
      "default": false,
      "description": "Initialize every import, build local binaries, configure selected MCP clients, install user services, and run doctors."
    },
    "skills": {
      "default": true,
      "description": "Install signed skills only; do not build binaries, configure MCP, or install services."
    }
  },
  "releaseVersion": "1.15.0",
  "repository": "https://github.com/Prometheus-AGS/prometheus-skill-system.git",
  "schemaVersion": "prometheus-skill-system-v1",
  "targets": [
    {
      "detect": [
        ".agents",
        ".codex",
        ".opencode",
        ".kimi-code",
        ".minimax",
        ".cursor",
        ".gemini",
        "command:codex",
        "command:opencode",
        "command:kimi",
        "command:cursor",
        "command:gemini"
      ],
      "id": "agents",
      "mode": "copy",
      "path": ".agents/skills",
      "sourceTreeLifecycle": "install-only"
    },
    {
      "detect": [
        ".claude",
        "command:claude"
      ],
      "id": "claude",
      "mode": "symlink",
      "path": ".claude/skills",
      "sourceTreeLifecycle": "install-only"
    },
    {
      "detect": [
        ".qwen",
        "command:qwen"
      ],
      "id": "qwen",
      "mode": "symlink",
      "path": ".qwen/skills",
      "sourceTreeLifecycle": "install-only"
    }
  ]
}
