{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KBD Phase Progress",
  "description": "Read-only compatibility projection for a KBD phase. Mutations go through the canonical KBD command interface.",
  "type": "object",
  "required": ["schemaVersion", "phase", "last_updated", "last_updated_by", "changes"],
  "properties": {
    "schemaVersion": {
      "const": "2",
      "description": "Canonical array-based KBD progress schema."
    },
    "generatedBy": {
      "type": "string",
      "description": "kbd-runtime for replay-derived projections; absent only for legacy-read-only input."
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "Canonical event revision used to render this projection."
    },
    "phase": {
      "type": "string",
      "description": "Active phase name, e.g. 'phase-2-sales-module'"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "last_updated_by": {
      "type": "string",
      "minLength": 1,
      "description": "The AI tool or human who last wrote this file"
    },
    "assessment_complete": {
      "type": "boolean",
      "description": "True once /kbd-assess has run for this phase"
    },
    "plan_complete": {
      "type": "boolean",
      "description": "True once /kbd-plan has run for this phase"
    },
    "execution_dispatched": {
      "type": "boolean",
      "description": "True once /kbd-execute has written execution.md"
    },
    "reflection_complete": {
      "type": "boolean",
      "description": "True once /kbd-reflect has written the reflection"
    },
    "changes_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias of completion.implementation.total. It MUST NOT include evidence, certification, or publication gates."
    },
    "changes_completed": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy alias of completion.implementation.completed. It MUST NOT be reduced by incomplete evidence, certification, or publication gates."
    },
    "implementation_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Flat compatibility alias of completion.implementation.total."
    },
    "implementation_completed": {
      "type": "integer",
      "minimum": 0,
      "description": "Flat compatibility alias of completion.implementation.completed."
    },
    "completion": {
      "type": "object",
      "required": ["primaryCounter", "implementation"],
      "description": "Independent completion dimensions. Only implementation contributes to the KBD N/N change counter.",
      "properties": {
        "primaryCounter": { "const": "implementation" },
        "implementation": { "$ref": "#/$defs/countDimension" },
        "evidence": { "$ref": "#/$defs/statusDimension" },
        "certification": { "$ref": "#/$defs/statusDimension" },
        "publication": { "$ref": "#/$defs/statusDimension" }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "description": "Ordered array of per-change progress rows. IDs are unique and order is execution order.",
      "items": {
        "type": "object",
        "required": ["id", "status", "implementation_status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "DONE", "BLOCKED", "SKIPPED"]
          },
          "implementation_status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETE", "BLOCKED", "SKIPPED"],
            "description": "Canonical code/integration state. COMPLETE contributes to completion.implementation; evidence state never does."
          },
          "evidence_status": {
            "$ref": "#/$defs/dimensionStatus",
            "description": "Evidence-generation state, independent from implementation_status."
          },
          "certification_status": {
            "$ref": "#/$defs/dimensionStatus",
            "description": "Certification state, independent from implementation_status."
          },
          "publication_status": {
            "$ref": "#/$defs/dimensionStatus",
            "description": "Publication state, independent from implementation_status."
          },
          "tasks_total": {
            "type": "integer",
            "description": "Total number of tasks in this change (from tasks.md or change.md)"
          },
          "tasks_done": {
            "type": "integer",
            "description": "Number of tasks completed"
          },
          "last_task_completed": {
            "type": ["string", "null"],
            "description": "Description of the last completed task"
          },
          "next_task_pending": {
            "type": ["string", "null"],
            "description": "Description of the next pending task"
          },
          "started_by": {
            "type": ["string", "null"],
            "description": "Tool that started execution of this change"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completed_by": {
            "type": ["string", "null"],
            "description": "Tool that completed this change"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of blocker descriptions"
          },
          "notes": {
            "type": ["string", "null"],
            "description": "Optional notes from the executing tool"
          }
        },
        "additionalProperties": true
      }
    },
    "children": {
      "type": "object",
      "description": "Aggregated child-loop progress, recomputed by shared/lib/rollup.sh kbd_rollup_children. Keyed by child name. Non-breaking addition; present only when this node has children.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "enum": ["PENDING", "IN_PROGRESS", "DONE"] },
          "changes_completed": { "type": "integer", "minimum": 0 },
          "changes_total": { "type": "integer", "minimum": 0 },
          "implementation_completed": { "type": "integer", "minimum": 0 },
          "implementation_total": { "type": "integer", "minimum": 0 },
          "certification_status": { "$ref": "#/$defs/dimensionStatus" },
          "handoff": { "type": ["string", "null"], "description": "Path to the child's handoff-out.md when it exited." },
          "completed_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "dimensionStatus": {
      "type": "string",
      "enum": ["NOT_TRACKED", "NOT_REQUIRED", "PENDING", "IN_PROGRESS", "COMPLETE", "BLOCKED"]
    },
    "statusDimension": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/dimensionStatus" },
        "summary": { "type": ["string", "null"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "countDimension": {
      "type": "object",
      "required": ["completed", "total", "status"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/dimensionStatus" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
