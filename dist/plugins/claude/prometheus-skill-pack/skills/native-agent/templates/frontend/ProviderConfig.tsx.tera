{{- /*
  ProviderConfig.tsx.tera — Provider/model selector (read-only, no add-new)
  Variables:
    agent_name : kebab-case agent name
*/ -}}
import { useAgentConfig } from '../lib/api'

interface ProviderConfigProps {
  currentModel:    string
  currentProvider: string
  onModelChange:    (model: string) => void
  onProviderChange: (provider: string) => void
}

/**
 * Provider and model switcher.
 * Shows only configured providers — adding new providers requires editing agent.toml
 * and restarting with `{{ agent_name }} start`.
 */
export function ProviderConfig({
  currentModel,
  currentProvider,
  onModelChange,
  onProviderChange,
}: ProviderConfigProps) {
  const { data: config, isLoading } = useAgentConfig()

  if (isLoading || !config) {
    return <div className="text-xs text-muted-foreground">Loading…</div>
  }

  const activeProvider = config.providers.find(p => p.name === currentProvider)

  return (
    <div className="flex items-center gap-2">
      {/* Provider selector */}
      <select
        value={currentProvider}
        onChange={(e) => {
          const p = config.providers.find(x => x.name === e.target.value)
          onProviderChange(e.target.value)
          if (p?.models?.[0]) onModelChange(p.models[0])
        }}
        className="text-xs border rounded px-2 py-1 bg-background"
      >
        {config.providers.map(p => (
          <option key={p.name} value={p.name}>{p.name}</option>
        ))}
      </select>

      {/* Model selector — filtered to active provider */}
      {activeProvider && (
        <select
          value={currentModel}
          onChange={(e) => onModelChange(e.target.value)}
          className="text-xs border rounded px-2 py-1 bg-background"
        >
          {activeProvider.models.map(m => (
            <option key={m} value={m}>{m}</option>
          ))}
        </select>
      )}
    </div>
  )
}
