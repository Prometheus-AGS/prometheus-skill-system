{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheusags.ai/schemas/knowme-builder-manifest-v1.json",
  "title": "KnowMe Builder Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "contracts",
    "distribution",
    "profiles",
    "skills",
    "commands",
    "templates",
    "generatedTargets",
    "generatedCommandRoots",
    "supportedHarnesses"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "required": ["id", "displayName", "version", "description", "license", "repository", "author"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^2\\.0\\.0-(alpha|beta)\\.[0-9]+$|^2\\.0\\.0$" },
        "description": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "organization": { "type": "string" }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": ["prometheus", "uar", "agentSkills"],
      "additionalProperties": { "type": "string" }
    },
    "distribution": {
      "type": "object",
      "required": ["skillSourceRoot", "packageSkill"],
      "properties": {
        "skillSourceRoot": { "const": "skills" },
        "packageSkill": { "const": "hybrid-mobile-architecture" }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "surfaces", "uarMode", "runnableVerticalSlice"],
        "properties": {
          "description": { "type": "string" },
          "surfaces": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "uarMode": { "enum": ["embedded", "service", "hybrid"] },
          "runnableVerticalSlice": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 29,
      "uniqueItems": true
    },
    "commands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "status"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "status": { "const": "maintained" }
        },
        "additionalProperties": false
      }
    },
    "generatedTargets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "generatedCommandRoots": {
      "type": "object",
      "required": ["claude-code", "codex", "opencode", "kimi-code"],
      "properties": {
        "claude-code": { "type": "string" },
        "codex": { "type": "string" },
        "opencode": { "type": "string" },
        "kimi-code": { "type": "string" }
      },
      "additionalProperties": false
    },
    "supportedHarnesses": {
      "type": "array",
      "items": { "enum": ["claude-code", "codex", "opencode", "kimi-code"] },
      "minItems": 4,
      "uniqueItems": true
    }
  }
}
