{
  "schemaVersion": "hook-contract-v1",
  "dispatcherAbi": "hook-runtime-v1",
  "harnesses": ["claude-code", "codex"],
  "events": [
    {
      "event": "SessionStart",
      "matcher": "*",
      "description": "Bounded canonical KBD session adapter",
      "groupId": "sessionstart:kbd-control",
      "hooks": [
        {
          "id": "sessionstart-kbd-control",
          "target": "shared/scripts/kbd-harness-adapter.sh",
          "args": ["session_start", "{harness}"],
          "timeout": 10
        }
      ]
    },
    {
      "event": "SessionStart",
      "matcher": "*",
      "description": "kbd-open — prime session with KBD phase context + focused wiki + pending skill-updates",
      "groupId": "sessionstart:kbd-open",
      "hooks": [
        {
          "id": "sessionstart-kbd-open",
          "target": "shared/scripts/kbd-open.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        }
      ]
    },
    {
      "event": "SessionStart",
      "hooks": [
        {
          "id": "sessionstart-detect-project-context",
          "target": "shared/scripts/detect-project-context.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 15
        },
        {
          "id": "sessionstart-memory-outbox-flush",
          "target": "shared/scripts/memory-outbox-flush.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        },
        {
          "id": "sessionstart-pk-health",
          "target": "shared/scripts/pk-health.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        }
      ]
    },
    {
      "event": "UserPromptSubmit",
      "hooks": [
        {
          "id": "prompt-karpathy-learning",
          "target": "shared/scripts/karpathy-hook-dispatch.sh",
          "args": ["prompt", "{harness}"]
        }
      ]
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "id": "posttool-validate-evolution-state",
          "target": "skills/process/iterative-evolver/scripts/validate-state.sh",
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "posttool-validate-gitops-write",
          "target": "shared/scripts/validate-gitops-write.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        },
        {
          "id": "posttool-scope-record",
          "target": "shared/scripts/scope-record.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        },
        {
          "id": "posttool-write-position-reminder",
          "target": "shared/scripts/write-position-reminder.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        },
        {
          "id": "posttool-sycophancy-artifact",
          "target": "shared/scripts/sycophancy-check-artifact.sh",
          "timeout": 35
        },
        {
          "id": "posttool-memory-writeback",
          "target": "shared/scripts/memory-writeback.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 10
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^iterative-evolver:assessor$",
      "harnesses": ["claude-code"],
      "hooks": [
        {
          "id": "subagent-assessor-checkpoint",
          "target": "skills/process/iterative-evolver/scripts/state-checkpoint.sh",
          "args": ["{evolution}", "assess", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-assessor-dispatch",
          "target": "skills/process/iterative-evolver/scripts/workflow-dispatch.sh",
          "args": ["{evolution}", "phase_complete", "assess"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^iterative-evolver:analyst$",
      "harnesses": ["claude-code"],
      "hooks": [
        {
          "id": "subagent-analyst-checkpoint",
          "target": "skills/process/iterative-evolver/scripts/state-checkpoint.sh",
          "args": ["{evolution}", "analyze", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-analyst-dispatch",
          "target": "skills/process/iterative-evolver/scripts/workflow-dispatch.sh",
          "args": ["{evolution}", "phase_complete", "analyze"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^iterative-evolver:planner$",
      "harnesses": ["claude-code"],
      "hooks": [
        {
          "id": "subagent-planner-checkpoint",
          "target": "skills/process/iterative-evolver/scripts/state-checkpoint.sh",
          "args": ["{evolution}", "plan", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-planner-dispatch",
          "target": "skills/process/iterative-evolver/scripts/workflow-dispatch.sh",
          "args": ["{evolution}", "phase_complete", "plan"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^iterative-evolver:executor$",
      "harnesses": ["claude-code"],
      "hooks": [
        {
          "id": "subagent-executor-karpathy-learning",
          "target": "shared/scripts/karpathy-hook-dispatch.sh",
          "args": ["executor_complete", "{harness}"]
        },
        {
          "id": "subagent-executor-validate-state",
          "target": "skills/process/iterative-evolver/scripts/validate-state.sh",
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-executor-checkpoint",
          "target": "skills/process/iterative-evolver/scripts/state-checkpoint.sh",
          "args": ["{evolution}", "execute", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-executor-evaluate-session",
          "target": "shared/scripts/evaluate-session.sh",
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 30
        },
        {
          "id": "subagent-executor-dispatch",
          "target": "skills/process/iterative-evolver/scripts/workflow-dispatch.sh",
          "args": ["{evolution}", "phase_complete", "execute"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^iterative-evolver:reflector$",
      "harnesses": ["claude-code"],
      "hooks": [
        {
          "id": "subagent-reflector-sycophancy",
          "target": "shared/scripts/sycophancy-check-reflection.sh",
          "stderrToStdout": true,
          "timeout": 35
        },
        {
          "id": "subagent-reflector-log",
          "target": "skills/process/iterative-evolver/scripts/log-reflection.sh",
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-reflector-checkpoint",
          "target": "skills/process/iterative-evolver/scripts/state-checkpoint.sh",
          "args": ["{evolution}", "reflect", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-reflector-dispatch",
          "target": "skills/process/iterative-evolver/scripts/workflow-dispatch.sh",
          "args": ["{evolution}", "phase_complete", "reflect"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^assessor$",
      "harnesses": ["codex"],
      "hooks": [
        {
          "id": "subagent-assessor-checkpoint-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/state-checkpoint.sh", "{evolution}", "assess", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-assessor-dispatch-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/workflow-dispatch.sh", "{evolution}", "phase_complete", "assess"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^analyst$",
      "harnesses": ["codex"],
      "hooks": [
        {
          "id": "subagent-analyst-checkpoint-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/state-checkpoint.sh", "{evolution}", "analyze", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-analyst-dispatch-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/workflow-dispatch.sh", "{evolution}", "phase_complete", "analyze"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^planner$",
      "harnesses": ["codex"],
      "hooks": [
        {
          "id": "subagent-planner-checkpoint-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/state-checkpoint.sh", "{evolution}", "plan", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-planner-dispatch-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/workflow-dispatch.sh", "{evolution}", "phase_complete", "plan"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^executor$",
      "harnesses": ["codex"],
      "hooks": [
        {
          "id": "subagent-executor-karpathy-learning-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["shared/scripts/karpathy-hook-dispatch.sh", "executor_complete", "{harness}"]
        },
        {
          "id": "subagent-executor-validate-state-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/validate-state.sh"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-executor-checkpoint-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/state-checkpoint.sh", "{evolution}", "execute", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-executor-evaluate-session-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["shared/scripts/evaluate-session.sh"],
          "stderrToStdout": true,
          "ignoreFailure": true,
          "timeout": 30
        },
        {
          "id": "subagent-executor-dispatch-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/workflow-dispatch.sh", "{evolution}", "phase_complete", "execute"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "matcher": "^reflector$",
      "harnesses": ["codex"],
      "hooks": [
        {
          "id": "subagent-reflector-sycophancy-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["shared/scripts/sycophancy-check-reflection.sh"],
          "stderrToStdout": true,
          "timeout": 35
        },
        {
          "id": "subagent-reflector-log-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/log-reflection.sh"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-reflector-checkpoint-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/state-checkpoint.sh", "{evolution}", "reflect", "phase_complete"],
          "stderrToStdout": true,
          "ignoreFailure": true
        },
        {
          "id": "subagent-reflector-dispatch-codex",
          "target": "shared/scripts/team-role-guard.sh",
          "args": ["skills/process/iterative-evolver/scripts/workflow-dispatch.sh", "{evolution}", "phase_complete", "reflect"],
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "SubagentStop",
      "hooks": [
        {
          "id": "subagent-fallback-checkpoint",
          "target": "shared/scripts/subagent-checkpoint-fallback.sh",
          "stderrToStdout": true,
          "ignoreFailure": true
        }
      ]
    },
    {
      "event": "Stop",
      "hooks": [
        {
          "id": "stop-karpathy-learning",
          "target": "shared/scripts/karpathy-hook-dispatch.sh",
          "args": ["stop", "{harness}"]
        }
      ]
    },
    {
      "event": "TaskCompleted",
      "harnesses": ["claude-code"],
      "description": "Block only inconsistent completion of canonical KBD tasks",
      "groupId": "taskcompleted:kbd-receipt",
      "hooks": [
        {
          "id": "taskcompleted-kbd-receipt",
          "target": "shared/scripts/kbd-task-completed-gate.sh",
          "timeout": 10
        }
      ]
    },
    {
      "event": "PreCompact",
      "matcher": "*",
      "description": "Bounded canonical KBD pre-compaction checkpoint",
      "groupId": "precompact:kbd-control",
      "hooks": [
        {
          "id": "precompact-kbd-control",
          "target": "shared/scripts/kbd-harness-adapter.sh",
          "args": ["pre_compact", "{harness}"],
          "timeout": 10
        }
      ]
    }
  ]
}
