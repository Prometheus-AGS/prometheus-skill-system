<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.prometheus.hooks-logrotate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROMETHEUS_ROOT__/shared/scripts/rotate-hooks-log.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__PROMETHEUS_HOME__</string>
    <key>USER</key><string>__PROMETHEUS_USER__</string>
    <key>PATH</key><string>__PROMETHEUS_PATH__</string>
    <key>PROMETHEUS_LOGROTATE_BIN</key><string>__LOGROTATE_BIN__</string>
    <key>PROMETHEUS_FLOCK_BIN</key><string>__FLOCK_BIN__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__PROMETHEUS_LOG_DIR__/hooks-logrotate.stdout.log</string>
  <key>StandardErrorPath</key><string>__PROMETHEUS_LOG_DIR__/hooks-logrotate.stderr.log</string>
</dict>
</plist>
