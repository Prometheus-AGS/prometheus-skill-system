{
  "id": "20-missing-source-digests-are-refused",
  "acceptance": [
    1
  ],
  "description": "Evidence without sourceDigests is refused by both routes with the same reason.",
  "steps": [
    {
      "op": "adopt",
      "expect": {
        "exit": 0
      }
    },
    {
      "op": "evidence",
      "args": {
        "statuses": {
          "CS-1": "PASS",
          "CS-2": "PASS"
        },
        "sources": "none"
      }
    },
    {
      "op": "cli-close",
      "args": {
        "disposition": "pass"
      },
      "expect": {
        "exit": 7,
        "stderr": "evidence-source-digests-missing"
      }
    },
    {
      "op": "assert",
      "args": {
        "disposition": "OPEN",
        "phaseStatus": "in_progress",
        "events": {
          "phase_disposition_recorded": 0
        }
      }
    },
    {
      "op": "close-eval",
      "expect": {
        "exit": 2,
        "stdout": "^BLOCKED .*reason=evidence-source-digests-missing"
      }
    },
    {
      "op": "assert",
      "args": {
        "disposition": "REFUSED_BLOCKED",
        "phaseStatus": "in_progress",
        "events": {
          "phase_disposition_recorded": 1,
          "phase_successor_started": 0
        }
      }
    },
    {
      "op": "cli-close",
      "args": {
        "disposition": "pass"
      },
      "expect": {
        "exit": 7,
        "stderr": "evidence-source-digests-missing"
      }
    },
    {
      "op": "assert",
      "args": {
        "disposition": "REFUSED_BLOCKED",
        "phaseStatus": "in_progress",
        "events": {
          "phase_disposition_recorded": 1
        }
      }
    }
  ]
}
