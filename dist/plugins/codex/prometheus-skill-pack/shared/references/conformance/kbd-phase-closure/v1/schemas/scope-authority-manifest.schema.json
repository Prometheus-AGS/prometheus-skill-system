{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kbd.scope-authority/v1",
  "title": "Scope-authority manifest an operator signs (namespace prometheus-kbd-scope-amendment)",
  "description": "The file is JCS canonical JSON plus one newline. The operator signs these exact bytes using ssh-keygen -Y sign.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "namespace",
    "action",
    "projectId",
    "runId",
    "phaseId",
    "reason",
    "approver",
    "timestamp",
    "nonce"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "kbd.scope-authority"
    },
    "namespace": {
      "const": "prometheus-kbd-scope-amendment"
    },
    "action": {
      "enum": [
        "amend-contract",
        "start-successor",
        "supersede-exit"
      ]
    },
    "projectId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "phaseId": {
      "type": "string"
    },
    "contractPath": {
      "type": "string"
    },
    "previousContractDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "newContractDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenarioChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "modified",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "predecessorClosureKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successorPhaseId": {
      "type": "string"
    },
    "successorTitle": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 10
    },
    "approver": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "boundContractDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operatorDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "text"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "exercised": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "scopeRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "withdrawn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "destination"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "scenario",
              "scope"
            ]
          },
          "destination": {
            "type": "string",
            "pattern": "^(https://[^\\s/]+/[^\\s]+|[A-Za-z0-9_.-]+)$"
          }
        }
      }
    },
    "budgetAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "measured",
            "estimated",
            "unmetered"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "unmetered"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "amend-contract"
          }
        }
      },
      "then": {
        "required": [
          "contractPath",
          "previousContractDigest",
          "newContractDigest",
          "scenarioChanges"
        ],
        "properties": {
          "boundContractDigest": false,
          "budgetAccounting": false,
          "exercised": false,
          "limits": false,
          "operatorDecision": false,
          "predecessorClosureKey": false,
          "successorPhaseId": false,
          "successorTitle": false,
          "withdrawn": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "start-successor"
          }
        }
      },
      "then": {
        "required": [
          "predecessorClosureKey",
          "successorPhaseId",
          "successorTitle"
        ],
        "properties": {
          "boundContractDigest": false,
          "budgetAccounting": false,
          "contractPath": false,
          "exercised": false,
          "limits": false,
          "newContractDigest": false,
          "operatorDecision": false,
          "previousContractDigest": false,
          "scenarioChanges": false,
          "withdrawn": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "supersede-exit"
          }
        }
      },
      "then": {
        "required": [
          "boundContractDigest",
          "operatorDecision",
          "exercised",
          "withdrawn",
          "budgetAccounting",
          "limits"
        ],
        "properties": {
          "contractPath": false,
          "newContractDigest": false,
          "predecessorClosureKey": false,
          "previousContractDigest": false,
          "scenarioChanges": false,
          "successorPhaseId": false,
          "successorTitle": false
        }
      }
    }
  ]
}
