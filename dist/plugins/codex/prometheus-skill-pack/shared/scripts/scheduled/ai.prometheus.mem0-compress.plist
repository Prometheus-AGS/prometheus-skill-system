<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.prometheus.mem0-compress</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>PROMETHEUS_SKILL_PACK_ROOT/shared/scripts/mem0-compress.sh</string>
    </array>

    <!-- Run every Sunday at 03:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>PROMETHEUS_LOG_DIR/mem0-compress-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>PROMETHEUS_LOG_DIR/mem0-compress-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
