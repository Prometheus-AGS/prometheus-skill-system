[package]
name = "{{ skill_name }}"
version = "{{ skill_version | default(value="0.1.0") }}"
edition = "2021"
description = "{{ skill_description }}"
{% if crate_authors -%}
authors = [{% for a in crate_authors %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% else -%}
authors = ["your-name"]
{% endif -%}
license = "MIT"

# cdylib produces a single .wasm artifact suitable for LibreFang's
# WasmSandbox. Do NOT change to "lib" or add "rlib" — wasmtime won't
# find the required exports.
[lib]
crate-type = ["cdylib"]

[dependencies]
# JSON I/O across the host/guest boundary. Both crates work cleanly under
# wasm32-unknown-unknown with default features.
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# Stripping symbols and aggressive opt levels are the difference between a
# 1.5 MB and a 200 KB .wasm. LibreFang doesn't care about debug symbols
# inside the guest — they bloat the upload zip and slow down sandbox
# instantiation.
[profile.release]
opt-level = "z"        # smallest binary
lto = true             # cross-module link-time optimization
codegen-units = 1      # better optimization, slower compile
panic = "abort"        # panics in WASM cannot unwind the host anyway
strip = true           # remove all symbols
