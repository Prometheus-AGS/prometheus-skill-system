{{- /*
  package.json.tera — React 19 frontend package.json
  Variables:
    agent_name : kebab-case agent name
    port       : agent server port
*/ -}}
{
  "name": "{{ agent_name }}-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":     "vite --port 5173",
    "build":   "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react":            "^19.0.0",
    "react-dom":        "^19.0.0",
    "@assistant-ui/react":           "latest",
    "@assistant-ui/react-ai-sdk":    "latest",
    "@tanstack/react-router":        "latest",
    "@tanstack/react-query":         "latest",
    "zustand":                       "^5.0.0",
    "tailwind-merge":                "latest",
    "clsx":                          "latest",
    "lucide-react":                  "latest"
  },
  "devDependencies": {
    "@types/react":                  "^19.0.0",
    "@types/react-dom":              "^19.0.0",
    "@vitejs/plugin-react":          "latest",
    "vite":                          "^8.0.0",
    "typescript":                    "^6.0.0",
    "tailwindcss":                   "^4.0.0",
    "@tailwindcss/vite":             "latest"
  }
}
