{
  "repository": "Prometheus-AGS/prometheus-skill-system",
  "format": "bundle",
  "services": {
    "liter-llm": {"binary": "liter-llm", "directory": "tools/liter-llm", "port": 4000, "args": ["api","--host","0.0.0.0","--port","4000","--config","/etc/prometheus/liter.toml"]},
    "surreal-memory": {"binary": "surreal-memory-server", "directory": "tools/surreal-memory-server", "port": 3001, "env": {"API_HOST":"0.0.0.0","API_PORT":"3001","AUTH_MODE":"jwt","MCP_STDIO":"false","SURREAL_MODE":"server","EMBEDDING_PROVIDER":"local"}},
    "openai-proxy": {"binary": "openai-proxy", "directory": "tools/openai-proxy", "port": 8181, "env": {"HOST":"0.0.0.0","PORT":"8181"}, "args": ["serve"]},
    "pk-cherry": {"binary": "pk-cherry", "directory": "tools/prometheus-knowledge", "port": 8942, "env": {"PK_BIND":"0.0.0.0:8942","PK_KB_DIR":"/home/prometheus/.prometheus/knowledge"}},
    "forge-mcp": {"binary":"forge","directory":"tools/forge-rs","companions":["pk"],"port":8943,"args":["--project-root","/work","--skills-root","/pack","mcp","--bind","0.0.0.0","--port","8943"]},
    "surface-bridge": {"binary":"surface-bridge","directory":"substrate/surface-bridge","port":17890,"relayTo":7890},
    "prometheus-research": {"binary":"prometheus-research","directory":"substrate/prometheus-research","runtimePackages":["jq","python3"],"port":17891,"relayTo":7891,"args":["--mode","server","--port","7891"]},
    "prometheus-exec": {"binary":"prometheus-exec","directory":"crates/prometheus-exec","args":["daemon","--socket","/run/prometheus/exec.sock","--state-dir","/home/prometheus/.prometheus/exec","--identity","/home/prometheus/.prometheus/exec/identity.json","--plugin-root","/pack"]},
    "learning-worker": {"binary":"prometheus-learning-worker","directory":"tools/prometheus-knowledge","args":["run-once"]}
  },
  "otherBinaries": {
    "prometheus":"CLI", "prometheus-hook":"harness hook", "pk":"CLI", "prometheus-rust-auditor":"CLI",
    "learner-model":"client-launched stdio", "surreal-memory-mlx-executor":"Apple-only subprocess",
    "sycophancy-correction":"client-launched stdio", "template-forge":"CLI", "template-forge-mcp":"client-launched stdio",
    "cowork":"CLI", "co":"CLI alias", "dsg":"CLI"
  }
}
