{
  "name": "prometheus-skill-pack",
  "version": "1.7.0",
  "description": "Enterprise-grade AI skills for React entity management, GitOps CI/CD, process orchestration, iterative evolution, BDD testing, P2P sovereign sync, and deep-research with prometheus-research binary",
  "type": "module",
  "scripts": {
    "check-prereqs": "bash scripts/check-prerequisites.sh",
    "setup": "bash scripts/check-prerequisites.sh --install",
    "build-tools": "bash scripts/check-prerequisites.sh --build-tools",
    "doctor": "RUSTUP_TOOLCHAIN=stable cargo run --manifest-path tools/prometheus-cli/Cargo.toml -- doctor --exclude control.kbd-runtime --exclude state.kbd-orchestrator --exclude control.kbd-rollout --exclude service:sovereign-sync",
    "doctor:fix": "RUSTUP_TOOLCHAIN=stable cargo run --manifest-path tools/prometheus-cli/Cargo.toml -- doctor --fix --dry-run --exclude control.kbd-runtime --exclude state.kbd-orchestrator --exclude control.kbd-rollout --exclude service:sovereign-sync",
    "doctor:refresh": "RUSTUP_TOOLCHAIN=stable cargo run --manifest-path tools/prometheus-cli/Cargo.toml -- doctor --refresh --dry-run --exclude control.kbd-runtime --exclude state.kbd-orchestrator --exclude control.kbd-rollout --exclude service:sovereign-sync",
    "docs:check": "npm --prefix site run docs:check",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:sync:check": "node scripts/docs-sync.mjs --check",
    "check:docs-exec-examples": "node scripts/check-prometheus-exec-doc-examples.mjs",
    "docs:examples": "bash scripts/run-prometheus-exec-doc-examples.sh",
    "test:docs-sync": "node scripts/tests/docs-sync.test.mjs",
    "check:workflow-policy": "node scripts/check-workflow-policy.mjs",
    "test:workflow-policy": "bash scripts/tests/test-workflow-policy.sh",
    "check:protected-tests": "node scripts/verify-protected-tests.mjs",
    "test:protected-tests": "node scripts/tests/verify-protected-tests.test.mjs",
    "check:local-review": "node scripts/local-review-receipt.mjs verify",
    "test:local-review": "node scripts/tests/local-review-receipt.test.mjs",
    "smoke-test": "bash scripts/smoke-test.sh",
    "validate": "node scripts/validate-skills.js --exclude-submodules",
    "validate:skill": "node scripts/validate-skills.js",
    "validate:strict": "node scripts/validate-skills.js --strict --exclude-submodules",
    "validate:signals": "node scripts/validate-progress-signals.js",
    "test:adversarial-fixtures": "bash skills/process/adversarial-review/tests/run-fixture-suite.sh",
    "test:reject-cap": "bash skills/process/adversarial-review/tests/test-reject-cap-override.sh",
    "test:decision-gate": "bash skills/process/adversarial-review/tests/test-decision-gate.sh",
    "test:automation-bias": "bash skills/process/adversarial-review/tests/test-automation-bias-gate.sh",
    "test:decision-log": "bash skills/process/adversarial-review/tests/test-decision-log.sh",
    "test:coach-separation": "bash skills/process/adversarial-review/tests/test-coach-reflector-separation.sh",
    "test:idea-fixtures": "bash skills/process/adversarial-review/tests/run-idea-fixture-suite.sh",
    "check:mobile-classification": "bash skills/process/adversarial-review/scripts/classify-mobile-execution.sh --check",
    "check:fabric-invariants": "bash skills/devops/fabric-integration/scripts/check-invariants.sh",
    "test:skill-ffi": "cd substrate/skill-ffi && RUSTUP_TOOLCHAIN=stable cargo test",
    "lint:pk": "bash shared/scripts/pk-lint.sh",
    "memory:compress": "bash shared/scripts/mem0-compress.sh",
    "build": "node scripts/generate-skill-system-distribution.js",
    "test": "node scripts/test-skills.js",
    "test:control-plane": "bash scripts/test-kbd-control-plane.sh",
    "validate:kbd-state": "node scripts/validate-kbd-state.js",
    "validate:kbd-writers": "node scripts/check-kbd-direct-writers.js",
    "validate:harness-adapters": "node scripts/check-harness-adapters.js",
    "generate:harness-adapters": "node scripts/generate-harness-adapters.js",
    "validate:skill-evals": "node scripts/check-skill-evals.js",
    "test:clean-install-parity": "bash shared/scripts/tests/test-clean-install-parity.sh",
    "test:install-policy": "bash scripts/tests/install-policy.test.sh",
    "lint": "node scripts/lint-skills.js",
    "format": "prettier --write --ignore-path .prettierignore \"**/*.{md,json,js,ts}\"",
    "check-format": "prettier --check --ignore-path .prettierignore \"**/*.{md,json,js,ts}\"",
    "dev": "node scripts/watch-skills.js",
    "install:user": "node scripts/install.js --scope user",
    "install:project": "node scripts/install.js --scope project",
    "install:platforms": "npx tsx scripts/install-platforms.ts",
    "install:platforms:list": "npx tsx scripts/install-platforms.ts --list",
    "install:opencode": "npx tsx scripts/install-platforms.ts --platform opencode",
    "uninstall:platforms": "npx tsx scripts/install-platforms.ts --uninstall",
    "install:daemons": "bash scripts/install-mcp-services.sh",
    "uninstall:daemons": "bash scripts/install-mcp-services.sh --unload",
    "health": "bash scripts/check-mcp-health.sh",
    "install:skills": "bash scripts/install-skills-flat.sh",
    "uninstall:skills": "bash scripts/install-skills-flat.sh --uninstall",
    "generate:commands": "node scripts/generate-commands.js",
    "register:commands": "bash scripts/register-slash-commands.sh && node scripts/generate-commands.js",
    "unregister:commands": "bash scripts/register-slash-commands.sh --uninstall && node scripts/generate-commands.js --uninstall",
    "skill-matrix": "node scripts/skill-matrix.js",
    "skill-matrix:ci": "node scripts/skill-matrix.js --ci",
    "check:opencode": "tsc -p .opencode/tsconfig.json --noEmit",
    "update": "bash scripts/update-skill-pack.sh",
    "update:force": "bash scripts/update-skill-pack.sh --force",
    "cucumber": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "build:codex": "node scripts/generate-skill-system-distribution.js",
    "validate:codex": "node scripts/generate-skill-system-distribution.js --check",
    "build:distribution": "node scripts/generate-skill-system-distribution.js",
    "check:distribution": "node scripts/generate-skill-system-distribution.js --check && node scripts/tests/skill-system-distribution.test.mjs",
    "generate:skills-index": "node scripts/generate-skills-index.js",
    "check:skills-index": "node scripts/generate-skills-index.js --check",
    "verify:skills": "node scripts/verify-skill-install.js",
    "test:verify-skills": "node scripts/tests/verify-skill-install.test.mjs"
  },
  "keywords": [
    "claude-code",
    "agent-skills",
    "agentskills",
    "react",
    "entity-management",
    "process-orchestration",
    "pmpo",
    "bdd-testing",
    "gitops",
    "devops",
    "argocd",
    "surreal-memory",
    "skills",
    "plugins",
    "ai-development"
  ],
  "author": {
    "name": "Travis James",
    "url": "https://travisjames.ai"
  },
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@opencode-ai/plugin": "1.15.12",
    "@opencode-ai/sdk": "^1.15.12",
    "@types/node": "^25.9.1",
    "ajv": "^8.12.0",
    "chokidar": "^5.0.0",
    "glob": "^8.1.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "22.23.1"
  }
}
