# logrotate config for ~/.prometheus/hooks.log
# Install: sudo cp prometheus-hooks /etc/logrotate.d/
# Or run user-level: logrotate --state ~/.logrotate.state prometheus-hooks
#
# Keeps 30 days of gzipped daily logs. Missing log is not an error
# (log is created on first hook run).

~/.prometheus/hooks.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0600
    dateext
    dateformat -%Y%m%d
    sharedscripts
}
