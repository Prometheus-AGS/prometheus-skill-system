{
  "schemaVersion": "1",
  "harness": "claude-code",
  "hooks": {
    "SessionStart": [
      {
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh session_start claude-code",
        "timeout": 1000
      }
    ],
    "PreCompact": [
      {
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh pre_compact claude-code",
        "timeout": 1000
      }
    ],
    "UserPromptSubmit": [
      {
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh prompt claude-code",
        "timeout": 1000
      }
    ],
    "Stop": [
      {
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh stop claude-code",
        "timeout": 250
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh pre_mutation claude-code",
        "timeout": 250
      }
    ]
  }
}
