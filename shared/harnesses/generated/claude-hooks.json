{
  "schemaVersion": "2",
  "harness": "claude-code",
  "hooks": {
    "SessionStart": [
      {
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh session_start claude-code",
        "timeout": 1000
      }
    ],
    "PreCompact": [
      {
        "command": "bash ${PROMETHEUS_SKILL_PACK_ROOT}/shared/scripts/kbd-harness-adapter.sh pre_compact claude-code",
        "timeout": 1000
      }
    ],
    "UserPromptSubmit": [
      {
        "command": "bash $HOME/.prometheus/plugins/prometheus-skill-pack/stable/karpathy-hook-dispatch.sh prompt claude-code"
      }
    ],
    "Stop": [
      {
        "command": "bash $HOME/.prometheus/plugins/prometheus-skill-pack/stable/karpathy-hook-dispatch.sh stop claude-code"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "executor",
        "command": "bash $HOME/.prometheus/plugins/prometheus-skill-pack/stable/karpathy-hook-dispatch.sh executor_complete claude-code"
      }
    ]
  }
}
