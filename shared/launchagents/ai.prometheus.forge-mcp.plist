<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.prometheus.forge-mcp</string>

  <key>ProgramArguments</key>
  <array>
    <string>__FORGE_BIN__</string>
    <string>mcp</string>
    <string>--port</string>
    <string>8943</string>
    <string>--project-root</string>
    <string>__PROMETHEUS_ROOT__</string>
    <string>--skills-root</string>
    <string>__PROMETHEUS_ROOT__</string>
    <string>--pk-mcp-url</string>
    <string>http://localhost:8942/mcp</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROMETHEUS_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__PROMETHEUS_HOME__</string>
    <key>USER</key>
    <string>__PROMETHEUS_USER__</string>
    <key>PATH</key>
    <string>__PROMETHEUS_PATH__</string>
    <key>PK_MCP_URL</key>
    <string>http://localhost:8942/mcp</string>
    <!-- Stable bearer token for the forge MCP server. forge REQUIRES a token
         (no --no-auth flag); without this it mints a random one each boot and
         clients 401. This is a localhost-only (127.0.0.1:8943) dev token,
         committed like the surrealdb root/root creds; the identical value is
         set in .mcp.json as `Authorization: Bearer`. -->
    <key>FORGE_MCP_TOKEN</key>
    <string>forge-mcp-local-dev-30dfefcc32263a0813ffdbd2</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__PROMETHEUS_LOG_DIR__/forge-mcp.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROMETHEUS_LOG_DIR__/forge-mcp.stderr.log</string>
</dict>
</plist>
