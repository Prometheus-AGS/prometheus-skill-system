      "args": {
        "statuses": {
          "CS-1": "PASS",
          "CS-2": "PASS"
        },
        "budget": "unmeasured"
      }
    },
    {
      "op": "close-eval",
      "expect": {
        "exit": 2,
        "stdout": "budget-unmeasured"
      }
    },
    {
      "op": "assert",
      "args": {
        "disposition": "REFUSED_BLOCKED",
        "phaseStatus": "in_progress"
      }
    }
