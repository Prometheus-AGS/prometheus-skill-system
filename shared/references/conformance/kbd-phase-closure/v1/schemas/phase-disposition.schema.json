{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kbd.phase-disposition/v1",
  "title": "Canonical phase disposition view (prometheus kbd phase disposition --json)",
  "type": "object",
  "required": [
    "schema",
    "projectId",
    "runId",
    "phaseId",
    "phaseStatus",
    "contractBound",
    "disposition",
    "dispatchAllowed",
    "successorAllowed",
    "awaitingSuccessor",
    "consumptionHighWater"
  ],
  "properties": {
    "schema": {
      "const": "kbd.phase-disposition/v1"
    },
    "projectId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "phaseId": {
      "type": "string"
    },
    "phaseStatus": {
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "complete",
        "cancelled"
      ]
    },
    "contractBound": {
      "type": "boolean"
    },
    "disposition": {
      "enum": [
        "UNBOUND",
        "OPEN",
        "CLOSED",
        "CLOSED_SUPERSEDED",
        "CLOSED_UNMET",
        "REFUSED_BLOCKED",
        "REFUSED_FAIL"
      ]
    },
    "binding": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "contractPath",
        "contractDigest",
        "scenarioDigests",
        "planRevision",
        "adoptionDecisionId",
        "bindingRevision"
      ],
      "properties": {
        "contractDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenarioDigests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "bindingRevision": {
          "type": "integer",
          "minimum": 1
        },
        "amendedScenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "closure": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "runId",
        "contractDigest",
        "evidenceDigest",
        "disposition",
        "closureKey",
        "recordedAtRevision"
      ],
      "properties": {
        "closureKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disposition": {
          "enum": [
            "pass",
            "superseded",
            "unmet"
          ]
        },
        "admissionVersion": {
          "type": "integer",
          "minimum": 2,
          "description": "Stamped by the admitting runtime on closures recorded with evidence admission (issue #219). Absent on closures recorded before it; those replay with their recorded semantics."
        },
        "evidenceFacts": {
          "type": "object",
          "description": "Evidence phase, projectId, sourceDigests and budgetConsumption.source as offered at admission.",
          "properties": {
            "phase": {
              "type": "string"
            },
            "projectId": {
              "type": "string"
            },
            "sourceDigests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "budgetSource": {
              "type": "string"
            }
          }
        },
        "operatorExit": {
          "type": "object",
          "description": "Parsed signed supersede-exit manifest. See kbd.scope-authority/v1.",
          "required": [
            "action",
            "boundContractDigest",
            "operatorDecision",
            "exercised",
            "withdrawn",
            "budgetAccounting",
            "limits"
          ],
          "properties": {
            "action": {
              "const": "supersede-exit"
            },
            "boundContractDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "operatorDecision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "text"
              ],
              "properties": {
                "reference": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "exercised": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "verdict",
                  "evidence"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "verdict": {
                    "enum": [
                      "PASS",
                      "FAIL"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  },
                  "scopeRefs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            },
            "withdrawn": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "destination"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "kind": {
                    "enum": [
                      "scenario",
                      "scope"
                    ]
                  },
                  "destination": {
                    "type": "string",
                    "pattern": "^(https://[^\\s/]+/[^\\s]+|[A-Za-z0-9_.-]+)$"
                  }
                }
              }
            },
            "budgetAccounting": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class"
              ],
              "properties": {
                "class": {
                  "enum": [
                    "measured",
                    "estimated",
                    "unmetered"
                  ]
                },
                "values": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "class": {
                        "const": "unmetered"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "values": {
                        "maxProperties": 0
                      }
                    }
                  },
                  "else": {
                    "required": [
                      "values"
                    ],
                    "properties": {
                      "values": {
                        "minProperties": 1
                      }
                    }
                  }
                }
              ]
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "exitAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifestRaw",
            "manifestSha256",
            "signature",
            "approver",
            "namespace",
            "allowedSignersSha256"
          ],
          "properties": {
            "manifestRaw": {
              "type": "string",
              "pattern": "\\S"
            },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "signature": {
              "type": "string",
              "pattern": "\\S"
            },
            "approver": {
              "type": "string",
              "pattern": "\\S"
            },
            "namespace": {
              "const": "prometheus-kbd-scope-amendment"
            },
            "allowedSignersSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "lastRefusal": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "fail",
            "blocked"
          ]
        },
        "reasonCode": {
          "type": "string"
        }
      }
    },
    "successor": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "phaseId",
        "manifestSha256",
        "startedAtRevision"
      ]
    },
    "consumptionHighWater": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "awaitingSuccessor": {
      "type": "boolean"
    },
    "dispatchAllowed": {
      "type": "boolean"
    },
    "successorAllowed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "CLOSED"
          }
        }
      },
      "then": {
        "required": [
          "closure"
        ],
        "properties": {
          "contractBound": {
            "const": true
          },
          "dispatchAllowed": {
            "const": false
          },
          "closure": {
            "type": "object",
            "properties": {
              "disposition": {
                "const": "pass"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "CLOSED_SUPERSEDED"
          }
        }
      },
      "then": {
        "required": [
          "closure"
        ],
        "properties": {
          "contractBound": {
            "const": true
          },
          "dispatchAllowed": {
            "const": false
          },
          "closure": {
            "type": "object",
            "properties": {
              "disposition": {
                "const": "superseded"
              },
              "operatorExit": {
                "properties": {
                  "exercised": {
                    "minItems": 1
                  }
                }
              }
            },
            "required": [
              "operatorExit",
              "exitAuthority"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "CLOSED_UNMET"
          }
        }
      },
      "then": {
        "required": [
          "closure"
        ],
        "properties": {
          "contractBound": {
            "const": true
          },
          "dispatchAllowed": {
            "const": false
          },
          "closure": {
            "type": "object",
            "properties": {
              "disposition": {
                "const": "unmet"
              },
              "operatorExit": {
                "properties": {
                  "exercised": {
                    "maxItems": 0
                  }
                }
              }
            },
            "required": [
              "operatorExit",
              "exitAuthority"
            ]
          }
        }
      }
    }
  ]
}
