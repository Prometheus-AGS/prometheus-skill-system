[Unit]
Description=Prometheus asynchronous learning worker

[Service]
Type=oneshot
WorkingDirectory=__PROMETHEUS_ROOT__
Environment=HOME=__PROMETHEUS_HOME__
Environment=USER=__PROMETHEUS_USER__
Environment=PATH=__PROMETHEUS_PATH__
ExecStart=__LEARNING_WORKER_BIN__ run-once
StandardOutput=append:__PROMETHEUS_LOG_DIR__/learning-worker.stdout.log
StandardError=append:__PROMETHEUS_LOG_DIR__/learning-worker.stderr.log
