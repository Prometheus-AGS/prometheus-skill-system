# systemd --user oneshot — Prometheus periodic self-learning nudge.
# Mirrors shared/launchagents/ai.prometheus.prometheus-nudge.plist (StartInterval=14400).
# Driven by ai.prometheus.prometheus-nudge.timer; no [Install] of its own.
[Unit]
Description=Prometheus periodic self-learning nudge (oneshot)

[Service]
Type=oneshot
WorkingDirectory=__PROMETHEUS_ROOT__
Environment=HOME=__PROMETHEUS_HOME__
Environment=USER=__PROMETHEUS_USER__
Environment=PATH=__PROMETHEUS_PATH__
Environment=PROMETHEUS_SKILL_PACK_ROOT=__PROMETHEUS_ROOT__
Environment=SURREAL_MEMORY_URL=http://localhost:23001
Environment=PK_MCP_URL=http://localhost:8942/mcp
ExecStart=/bin/bash __PROMETHEUS_ROOT__/scripts/scheduled/periodic-nudge.sh
StandardOutput=append:__PROMETHEUS_LOG_DIR__/prometheus-nudge.stdout.log
StandardError=append:__PROMETHEUS_LOG_DIR__/prometheus-nudge.stderr.log
