    "/api/v2/sync/pushes/{push_id}/events": {
      "get": {
        "operationId": "streamSyncPushEvents",
        "parameters": [
          {
            "in": "path",
            "name": "push_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/PushReceiptEvent"
                }
              }
            },
            "description": "text/event-stream of events strictly after the supplied sequence"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
