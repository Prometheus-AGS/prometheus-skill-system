    "/api/v2/sync/pushes/{push_id}": {
      "get": {
        "operationId": "getSyncPush",
        "parameters": [
          {
            "in": "path",
            "name": "push_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
