  "targets": [
    {
      "id": "agents",
      "path": ".agents/skills",
      "mode": "copy",
      "sourceTreeLifecycle": "required",
      "detect": [
        ".agents",
        ".codex",
        ".opencode",
        ".kimi-code",
        ".minimax",
        ".cursor",
        ".gemini",
        "command:codex",
        "command:opencode",
        "command:kimi",
        "command:cursor",
        "command:gemini"
      ]
    },
    {
      "id": "claude",
      "path": ".claude/skills",
      "mode": "symlink",
      "sourceTreeLifecycle": "install-only",
      "detect": [
        ".claude",
        "command:claude"
      ]
    },
    {
      "id": "qwen",
      "path": ".qwen/skills",
      "mode": "symlink",
      "sourceTreeLifecycle": "install-only",
      "detect": [
        ".qwen",
        "command:qwen"
      ]
    }
  ],
  "outputs": {
    "skillCatalog": "SKILLS.md",
    "claudeMarketplace": ".claude-plugin/marketplace.json",
    "codexMarketplace": ".agents/plugins/marketplace.json",
    "claudePackage": "dist/plugins/claude/prometheus-skill-pack",
    "claudeRuntimePackage": "dist/plugins/claude/prometheus-runtime",
    "codexPackage": "dist/plugins/codex/prometheus-skill-pack"
  }
