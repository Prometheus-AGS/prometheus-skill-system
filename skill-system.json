      },
      {
        "name": "prometheus-react-vite-stack",
        "path": "skills/react/react-vite-stack",
        "version": "1.0.0",
        "category": "frontend"
      },
      {
        "name": "iterative-evolver",
        "path": "skills/process/iterative-evolver",
        "version": "1.1.0",
        "category": "productivity"
      }
    ]
  },
  "domains": [
    {
      "id": "process",
      "plugins": [
        "prometheus-process-skills",
        "cowork-management"
      ],
      "inventoryRoots": [],
      "requires": [
        "iterative-evolver",
        "testing",
