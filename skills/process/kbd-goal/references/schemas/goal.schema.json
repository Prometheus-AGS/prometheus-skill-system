{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kbd-goal.schema.json",
  "title": "KBD Goal",
  "description": "Persistent goal state for a kbd-goal multi-phase loop. Backward-compatible extension of loop.json — existing loop.json files without phases[] continue to work.",
  "type": "object",
  "required": ["name", "slug", "description", "phases", "active_phase", "status", "tool", "created", "updated"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable goal name (same as description for single-goal)"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9](-[0-9]{8})?$",
      "description": "Kebab-case slug, optionally suffixed with YYYYMMDD"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "stopping_condition"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["ideation", "spec", "creation", "deployment", "custom"]
          },
          "type": {
            "type": "string",
            "enum": ["ideation", "spec", "creation", "deployment", "custom"]
          },
          "stopping_condition": {
            "type": "string",
            "description": "Machine-checkable or precisely human-evaluable stopping condition"
          },
          "human_gate": {
            "type": "boolean",
            "default": true,
            "description": "Whether human approval is required before advancing to next phase"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "paused", "complete", "escalated"],
            "default": "pending"
          }
        }
      }
    },
    "active_phase": {
      "type": "string",
      "description": "Name of the currently active phase"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "paused", "complete", "escalated"],
      "description": "Overall goal status"
    },
    "tool": {
      "type": "string",
      "enum": ["claude-code", "codex", "opencode", "kimi", "zed", "cursor", "windsurf"],
      "description": "AI tool detected at goal creation time"
    },
    "token_budget": {
      "type": "integer",
      "minimum": 1000,
      "default": 200000
    },
    "max_turns_per_phase": {
      "type": "integer",
      "minimum": 1,
      "default": 50
    },
    "max_no_progress_turns": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "auto_gates": {
      "type": "boolean",
      "default": false,
      "description": "Skip human gates between phases (dangerous — use only for fully automated pipelines)"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    }
  }
}
