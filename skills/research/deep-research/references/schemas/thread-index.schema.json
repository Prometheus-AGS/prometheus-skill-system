{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus-ags.dev/schemas/thread-index.schema.json",
  "title": "Thread dispatch ledger",
  "description": "Every dispatch gets a row, including the ones that failed. A ledger with silent holes cannot tell a director what to re-dispatch.",
  "type": "object",
  "required": ["schema_version", "package_id", "threads"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "package_id": { "type": "string", "minLength": 1 },
    "director_cycles": { "type": "integer", "minimum": 0 },
    "budget_hit": { "type": "boolean", "description": "True when a job- or director-level budget forced completion." },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread_id", "task", "status", "cycle", "started_at"],
        "additionalProperties": false,
        "properties": {
          "thread_id": { "type": "string", "pattern": "^t[0-9]{2,}$" },
          "task": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["complete", "partial", "failed", "timeout"],
            "description": "partial: budget truncated it but output survives. failed: it died. timeout: the scheduler killed it."
          },
          "cycle": { "type": "integer", "minimum": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": ["string", "null"], "format": "date-time" },
          "sources_count": { "type": "integer", "minimum": 0 },
          "claims_count": { "type": "integer", "minimum": 0 },
          "reason": {
            "type": ["string", "null"],
            "description": "Required whenever status is not complete. A row that says failed without saying why is a hole with a label on it."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["partial", "failed", "timeout"] } } },
            "then": { "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
          }
        ]
      }
    }
  }
}
