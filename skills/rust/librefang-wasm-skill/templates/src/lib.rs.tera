// ---------------------------------------------------------------------------
// Tool surface
// ---------------------------------------------------------------------------
//
// `execute` dispatches on `input.tool` to one of the implementations below.
// Each tool is a free function returning `Result<Value, String>`. The host
// will receive the JSON `Ok` payload, or `{"error": "<msg>"}` on `Err`.

#[derive(Deserialize)]
struct Invocation {
    /// Tool name from skill.toml.
    tool: String,
    /// Tool input matching the tool's input_schema.
    #[serde(default)]
    input: Value,
}

fn dispatch(inv: Invocation) -> Result<Value, String> {
    match inv.tool.as_str() {
{% for tool in tools | default(value=[{"name":"echo"}]) -%}
        "{{ tool.name }}" => tool_{{ tool.name | replace(from="-", to="_") }}(inv.input),
{% endfor -%}
        other => Err(format!("Unknown tool: {other}")),
    }
}

