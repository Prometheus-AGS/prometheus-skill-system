//! {{ skill_name }} — LibreFang WASM skill.
//!
//! This file defines the Guest ABI required by `librefang-runtime-wasm`:
//!
//!   memory                            — linear memory exposed to host
//!   alloc(size: i32) -> i32           — allocate `size` bytes, return ptr
//!   execute(ptr: i32, len: i32) -> i64 — main entry; returns packed (ptr<<32 | len)
//!
