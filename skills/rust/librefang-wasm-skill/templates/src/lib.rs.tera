// ---------------------------------------------------------------------------
// Guest ABI — exports the host expects.
// Edit only if you have read sandbox.rs and know what you are doing.
// ---------------------------------------------------------------------------

/// Allocate `size` bytes inside guest memory and return a pointer the host
/// can write to. The allocation is intentionally leaked — the host owns it
/// for the duration of the call. Reclaiming would corrupt host reads.
///
/// SAFETY: the host treats the returned i32 as `*mut u8` of length `size`.
/// Returning 0 means OOM; the host treats that as a sandbox failure.
#[no_mangle]
pub unsafe extern "C" fn alloc(size: i32) -> i32 {
    let size = size as usize;
    let mut buf: Vec<u8> = Vec::with_capacity(size);
    let ptr = buf.as_mut_ptr();
    std::mem::forget(buf);
    ptr as i32
}

/// Main entry point. Host writes JSON input at `ptr` (length `len`),
/// expects a packed result `(out_ptr << 32) | out_len` where the bytes at
/// `out_ptr` are JSON.
#[no_mangle]
pub unsafe extern "C" fn execute(ptr: i32, len: i32) -> i64 {
    let input_bytes = std::slice::from_raw_parts(ptr as *const u8, len as usize);
    let result = match serde_json::from_slice::<Invocation>(input_bytes) {
        Ok(inv) => match dispatch(inv) {
            Ok(v) => v,
            Err(e) => json!({ "error": e }),
        },
        Err(e) => json!({ "error": format!("Invalid invocation JSON: {e}") }),
    };

    let out_bytes = serde_json::to_vec(&result).unwrap_or_else(|_| b"{}".to_vec());
    let out_len = out_bytes.len() as i32;
    let out_ptr = alloc(out_len);
    std::ptr::copy_nonoverlapping(out_bytes.as_ptr(), out_ptr as *mut u8, out_bytes.len());

    pack(out_ptr, out_len)
}

/// Pack a (ptr, len) pair into a single i64 result, matching the host's
/// `unpack_result` in `sandbox.rs`. The host extracts:
///   ptr = (packed >> 32) as i32
///   len = (packed & 0xFFFF_FFFF) as i32
fn pack(ptr: i32, len: i32) -> i64 {
    ((ptr as i64) << 32) | (len as i64 & 0xFFFF_FFFF)
}

// Re-export the manifest-derived skill name for human inspection (e.g., in
// hex dumps of the .wasm). Strings get optimized out, but Wasmtime keeps
// `#[no_mangle]` exports that look like data references — useful for
// `wasm-tools dump` triage.
#[no_mangle]
pub static SKILL_NAME: &str = "{{ skill_name }}";
