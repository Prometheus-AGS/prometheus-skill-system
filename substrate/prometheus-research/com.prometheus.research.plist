<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prometheus.research</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/prometheus-research</string>
    <string>--mode</string>
    <string>server</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd gives a service only what its plist grants. Without PATH the
         daemon inherits the bare default and cannot resolve `claude` or `codex`,
         so `research_start` blocks with "no harness binary on PATH" even when
         both are installed (defect D-A, found by the change-rah-011 evidence
         run). __PROMETHEUS_PATH__ matches the shared/launchagents convention. -->
    <key>HOME</key>
    <string>__PROMETHEUS_HOME__</string>
    <key>USER</key>
    <string>__PROMETHEUS_USER__</string>
    <key>PATH</key>
    <string>__PROMETHEUS_PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/prometheus-research.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/prometheus-research.error.log</string>
</dict>
</plist>
