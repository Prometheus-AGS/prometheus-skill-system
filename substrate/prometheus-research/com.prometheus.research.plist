<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prometheus.research</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/prometheus-research</string>
    <string>--mode</string>
    <string>mcp</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/prometheus-research.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/prometheus-research.error.log</string>
</dict>
</plist>
