<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prometheusags.sovereign-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/sovereign-sync</string>
        <string>--mode</string>
        <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/sovereign-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/sovereign-sync.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>sovereign_sync=info</string>
    </dict>
</dict>
</plist>
