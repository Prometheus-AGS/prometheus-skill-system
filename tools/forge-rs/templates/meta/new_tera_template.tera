{{- /*
  META-TEMPLATE: new_tera_template.tera
  Generates a new .tera template file with proper header and variable documentation.

  This is a template that generates templates — the meta-template pattern.
  Output: skills/<language>/<skill-name>/templates/<template-name>.tera

  Usage: forge template new template <skill-path> <template-name>

  Variables:
    template_name    : filename without .tera (e.g. "router.rs")
    skill_name       : owning skill name (e.g. "axum-patterns")
    language         : language (e.g. "rust")
    output_purpose   : one-line description of what this template generates
    template_vars    : list of { name, type, description } variable docs
    sample_output    : optional example of what the rendered output looks like
*/ -}}
{{- "{{" }}-/*
  {{ template_name }}.tera — {{ output_purpose }}
  Skill: {{ skill_name }}

  VARIABLES — pass these when calling forge_enrich or forge template render:
{% for var in template_vars %}
    {{ var.name | pad_end(width=20) }} : {{ var.type | pad_end(width=12) }} — {{ var.description }}
{% endfor %}

  EDITING THIS TEMPLATE:
  1. Edit this file at: skills/{{ language }}/{{ skill_name }}/templates/{{ template_name }}.tera
  2. Run `forge template validate <skill-path>` to check Tera syntax
  3. Run `forge enrich <any-task-path>` — forge automatically picks up the updated template
  4. If the template should trigger on new keywords, update skill.toml triggers section

  META NOTE: This template was generated by forge from meta/new_tera_template.tera.
  To generate another template: forge template new template skills/{{ language }}/{{ skill_name }}/ <new-name>
*/ -}}{{- "}}" }}

{{- "{{" }}-/*
  TODO: Replace the content below with your actual template.

  Tera quick reference:
    {{ "{{" }} variable {{ "}}" }}                    — output a variable
    {{ "{%" }} if condition {{ "%}" }} ... {{ "{%" }} endif {{ "%}" }}   — conditionals
    {{ "{%" }} for item in list {{ "%}" }} ... {{ "{%" }} endfor {{ "%}" }} — loops
    {{ "{{" }} value | default(value="fallback") {{ "}}" }} — defaults
    {{ "{{" }} string | replace(from="a", to="b") {{ "}}" }} — string ops
    {{ "{{" }} list | json_encode() {{ "}}" }}         — serialize to JSON
*/ -}}{{- "}}" }}

